# Copy to .env.local and fill in what you have. Blank means "not available".
# Never commit .env.local. Never paste these values into chat, reports or issues.

# ESPN: league ID + season. Private leagues also need the espn_s2 and SWID cookies
# (SWID includes its curly braces). The cookies work like a password.
ESPN_LEAGUE_ID=
ESPN_SEASON=
ESPN_S2=
ESPN_SWID=

# Sleeper: either a username or a league ID is enough
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=

FLEAFLICKER_LEAGUE_ID=
FANTRAX_LEAGUE_ID=

# MFL: the login is only needed for private MFL leagues
MFL_LEAGUE_ID=
MFL_USERNAME=
MFL_PASSWORD=

# Yahoo (Phase 5, needs an approved Yahoo app)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Only for `npm run probe:yahoo` after approval: paste the one-time code from the consent redirect
# into YAHOO_AUTH_CODE; the probe then writes YAHOO_REFRESH_TOKEN here itself (never printed).
YAHOO_AUTH_CODE=
YAHOO_REFRESH_TOKEN=

# Generated by `npm run gen:secret` (writes straight into .env.local, never printed)
SESSION_SECRET=

# Development only, not a secret. By default `npm run dev` and `npm run import:report` import your
# ESPN league the way a leaguemate would (public link, pick your team). Set to 1 to use ESPN_S2 and
# ESPN_SWID above instead.
USE_ENV_COOKIES=

# Optional, only for the --live scripts that read the beta's shared store (npm run beta:log -- --live, usage:report,
# feedback:report and snapshot:pull), read-only. In Vercel, open Storage -> upstash-kv-alizarin-saddle and type, by hand
# (never `vercel env pull`, which would rewrite this file):
#   READONLY_STORE_URL   = the value of KV_REST_API_URL (the https:// REST address)
#   READONLY_STORE_TOKEN = the value of KV_REST_API_READ_ONLY_TOKEN (the read-only token: it can't change anything; the
#                          scripts read only after the store refuses a write made with it, and otherwise stop)
# The app never reads these two names. It talks to Upstash on Vercel only, so don't put the store's own variables here
# (KV_REST_API_URL, KV_REST_API_TOKEN, UPSTASH_REDIS_REST_*, KV_URL, REDIS_URL): nothing local reads them.
READONLY_STORE_URL=
READONLY_STORE_TOKEN=

# Leave blank. The daily snapshot cron's secret lives on Vercel (production), made there by
# `npm run vercel:secret -- --live --name CRON_SECRET` and never shown; Vercel sends it with each cron request. Set it here
# only to call /api/cron/snapshot on `npm run dev` yourself (it then writes the local archives in data-local/).
CRON_SECRET=
