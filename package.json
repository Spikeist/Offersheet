{
  "name": "fantasy-trade-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "stable": "tsx scripts/stable.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-env": "tsx scripts/check-env.ts",
    "gen:secret": "tsx scripts/gen-session-secret.ts",
    "check:leaks": "tsx scripts/check-leaks.ts",
    "check:sleeper-cors": "tsx scripts/check-sleeper-cors.ts",
    "check:browser": "tsx scripts/check-browser/index.ts",
    "probe:espn": "tsx scripts/probe-espn.ts",
    "probe:sleeper": "tsx scripts/probe-sleeper.ts",
    "probe:sleeper-codes": "tsx scripts/probe-sleeper-codes.ts",
    "probe:shared": "tsx scripts/probe-shared.ts",
    "probe:fleaflicker": "tsx scripts/probe-fleaflicker.ts",
    "probe:mfl": "tsx scripts/probe-mfl.ts",
    "probe:yahoo": "tsx scripts/probe-yahoo.ts",
    "probe:fantrax": "tsx scripts/probe-fantrax.ts",
    "probe:draft": "tsx scripts/probe-draft.ts",
    "probe:all": "tsx scripts/probe-all.ts",
    "import:report": "tsx scripts/import-report.ts",
    "oracle:report": "tsx scripts/oracle-report.ts",
    "league:report": "tsx scripts/league-report.ts",
    "trade:report": "tsx scripts/trade-report.ts",
    "measure:stat-sd": "tsx scripts/measure-stat-sd.ts",
    "measure:cache": "tsx scripts/measure-cache.ts",
    "measure:upload": "tsx scripts/measure-upload.ts",
    "load:test": "tsx scripts/load-test.ts",
    "beta:log": "tsx scripts/beta-log.ts",
    "usage:report": "tsx scripts/usage-report.ts",
    "preview:deploy": "tsx scripts/preview-deploy.ts",
    "prod:deploy": "tsx scripts/prod-deploy.ts",
    "publish:public": "tsx scripts/publish-public.ts",
    "vercel:secret": "tsx scripts/vercel-secret.ts",
    "snapshot:projections": "tsx scripts/snapshot-projections.ts",
    "snapshot:pull": "tsx scripts/snapshot-pull.ts",
    "feedback:summary": "tsx scripts/feedback-summary.ts",
    "feedback:report": "tsx scripts/feedback-report.ts",
    "gen:espn-constants": "tsx scripts/gen-espn-constants.ts",
    "minimize:espn": "tsx scripts/minimize/espn-public-league.ts && tsx scripts/minimize/espn-sleeper-stats.ts",
    "minimize:sleeper": "tsx scripts/minimize/sleeper.ts && tsx scripts/minimize/sleeper-flags.ts",
    "minimize:mfl": "tsx scripts/minimize/mfl-oracle.ts",
    "minimize:fleaflicker": "tsx scripts/minimize/fleaflicker-oracle.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "csv-parse": "^7.0.3",
    "iron-session": "^9.0.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
